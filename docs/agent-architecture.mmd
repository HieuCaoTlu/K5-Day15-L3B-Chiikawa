flowchart TB
    subgraph T["① THINKING · BƯỚC CHÍNH — agent phân tích ý tưởng bằng tư duy sản phẩm (có benchmark)"]
        direction LR
        U(["Trưởng nhóm gửi ý tưởng<br/>hoặc trả lời câu hỏi"]):::human --> G["guard_input<br/><i>code: độ dài, injection</i>"]:::code
        G -- "bị chặn" --> B(["Từ chối + lý do"]):::out
        G -- "hợp lệ" --> X["update_canvas<br/><i>Gemini: trích tin nhắn<br/>vào 9 ô AI MVP Canvas</i>"]:::llm
        X --> E["mark_evidence<br/><i>code: CÓ BẰNG CHỨNG khi có người cụ thể<br/>+ lần cụ thể + trích dẫn có thật</i>"]:::code
        E --> R{"4 ô lõi đủ<br/>bằng chứng?"}:::route
        R -- "còn thiếu" --> Q["ask_next<br/><i>NOT YET + hỏi đúng 1 câu</i>"]:::code
        Q -. "chờ tin nhắn tiếp" .-> U
        R -- "đủ, hoặc NO" --> V["verdict<br/><i>code: GO / NO</i>"]:::code
        V --> H["human_review<br/><i>trưởng nhóm Duyệt / Chưa duyệt</i>"]:::human
        H -- "Duyệt" --> F(["Canvas đã chốt"]):::out
        H -. "Chưa duyệt" .-> U
    end

    subgraph P["② PLANNING · mở rộng"]
        direction TB
        p1["Phân vai, user story"]:::ext
        p2["Task, trạng thái đổi theo sự kiện<br/>pull request (mô phỏng)"]:::ext
        p3["Chi phí và doanh thu"]:::ext
    end
    subgraph S["③ PITCHING · mở rộng"]
        direction TB
        s1["Tạo form khảo sát,<br/>link công khai"]:::ext
        s2["Dashboard phản hồi"]:::ext
        s3["Pitching HTML,<br/>bài quảng cáo"]:::ext
    end
    subgraph QL["④ QUALITY · mở rộng"]
        direction TB
        q1["Ghi các lần chạy thử,<br/>biểu đồ chất lượng"]:::ext
        q2["Token, chi phí,<br/>gợi ý lợi nhuận"]:::ext
    end
    subgraph M["⑤ MAINTAINING · mở rộng"]
        direction TB
        m1["Gợi ý cập nhật công nghệ"]:::ext
        m2["Lịch bảo trì,<br/>sức khỏe sản phẩm"]:::ext
    end

    T ==>|"Canvas đã duyệt"| P
    P ==> S
    S ==> QL
    QL ==> M
    T -. "metric lấy từ Canvas" .-> QL

