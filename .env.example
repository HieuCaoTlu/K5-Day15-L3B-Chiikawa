# ============================================================================
# Copy thành .env rồi điền. KHÔNG commit .env. Để nguyên file này vẫn chạy được (chế độ mock, không cần key).
#   cp .env.example .env            (Windows PowerShell: Copy-Item .env.example .env)
# ============================================================================

# ---- Docker compose ----
COMPOSE_PROJECT_NAME=hackathon
# Máy cá nhân: :80 (http://localhost). VPS: tên miền thật, Caddy tự cấp HTTPS, vd app.ten-mien.com
SITE_ADDRESS=:80
# URL công khai cho metadata / Open Graph khi build frontend
SITE_URL=http://localhost
# Đổi khi cổng 80/443/5432/8000 trên máy đã bị chiếm
HTTP_PORT=80
HTTPS_PORT=443
DB_PORT=5432
BACKEND_PORT=8000
# VPS: BẮT BUỘC đổi thành chuỗi ngẫu nhiên (python -c "import secrets; print(secrets.token_urlsafe(24))")
POSTGRES_PASSWORD=app

# ---- Backend ----
# development | production (production ẩn /docs)
APP_ENV=development
# Chỉ dùng khi chạy uvicorn ngoài Docker. docker compose tự ghi đè sang Postgres.
# Muốn dùng Postgres của compose khi chạy uvicorn ở máy: postgresql+psycopg://app:app@127.0.0.1:5432/app (dùng 127.0.0.1, không dùng localhost: Windows thử IPv6 trước, có thể treo)
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:3000
SEED_ON_START=true

# ---- Gemini ----
# Trống = mock (luật dự phòng, không gọi mạng). Mỗi người một key dev; bản demo dùng key riêng.
# Đặt giới hạn chi tiêu ở Google AI Studio / Cloud Billing, không chỉ dựa vào DAILY_BUDGET_USD.
GOOGLE_API_KEY=
# Flash cho hầu hết bước; Pro chỉ cho bước suy luận khó (llm.structured(..., pro=True)).
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
LLM_TIMEOUT_SECONDS=30

# ---- OpenRouter (tùy chọn thay cho Gemini) ----
# Nhà cung cấp LLM: auto (mặc định) | gemini | openrouter.
# auto: có GOOGLE_API_KEY thì dùng Gemini, chỉ có OPENROUTER_API_KEY thì dùng OpenRouter.
# LLM_PROVIDER=auto
# API key OpenRouter (tạo tại openrouter.ai/keys)
# OPENROUTER_API_KEY=
# Model nhanh cho hầu hết bước (mã model dạng provider/model của OpenRouter)
# OPENROUTER_MODEL_FAST=google/gemini-3.5-flash-lite
# Model cho bước suy luận khó (llm.structured(..., pro=True))
# OPENROUTER_MODEL_PRO=google/gemini-3.5-flash-lite

# ---- Chi phí (trang /admin/usage) ----
# Giá USD / 1 triệu token (input, output). Kiểm tra bảng giá Gemini hiện hành trước khi pitch số liệu.
PRICE_FAST_INPUT=0.30
PRICE_FAST_OUTPUT=2.50
PRICE_PRO_INPUT=1.25
PRICE_PRO_OUTPUT=10.0
# Tiêu hết trong ngày (UTC) → agent tự dùng luật dự phòng. 0 = không giới hạn.
DAILY_BUDGET_USD=5
USD_TO_VND=26000

# ---- Agent ----
# true → ưu tiên kết quả mẫu trong backend/app/agent/demo_cache.json (demo không phụ thuộc mạng / quota)
DEMO_MODE=false
# Node trả thẳng mock data (backend/app/agent/mocks/<node>.json): "all" hoặc "draft,human_review"
MOCK_NODES=
MAX_INPUT_CHARS=2000

# ---- Planning · GitHub App (TÙY CHỌN) ----
# Không cần điền: bấm "Kết nối GitHub" trong Planning. Chỉ điền khi đã có sẵn GitHub App.
# SITE_URL ở trên phải là origin người dùng mở (production dùng HTTPS).
# OAuth callback: <SITE_URL>/api/v1/planning/auth/github/callback
# Setup URL: <SITE_URL>/planning?github_setup=1
# Webhook URL: <SITE_URL>/api/v1/planning/github/webhook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Nội dung file .pem mã hóa Base64 một dòng
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=

# Không có webhook (localhost) thì backend tự đọc PR sau mỗi số giây này. 0 = tắt
PLANNING_POLL_SECONDS=60

# ---- Planning · Thông báo trình duyệt (TÙY CHỌN) ----
# Để trống thì Tầng tự tạo khóa. Đặt false để tắt thông báo.
PLANNING_PUSH_AUTO=true
# Hai khóa P-256 dạng Base64url, subject là mailto: địa chỉ của nhóm
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# ---- Hackathon: run.py / codebase/ai.py (starter-repo) ----
# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả (chưa gọi model) · openrouter / gemini / openai / anthropic / ollama …
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=
